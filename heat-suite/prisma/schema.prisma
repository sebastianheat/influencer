generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  REVIEW
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String?
  name         String
  role         Role            @default(BRAND)
  createdAt    DateTime        @default(now())
  brand        Brand?
  creator      CreatorProfile?
  connections  Connection[]
  messages     Message[]
}

model Connection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // instagram | tiktok | shopify | woocommerce | stripe
  externalId   String?
  username     String?
  accessToken  String?
  refreshToken String?
  shop         String? // shopify/woocommerce store domain
  scope        String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  // Stripe Connect (only for provider = "stripe")
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)

  @@unique([userId, provider])
}

model Brand {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  description String?
  logo        String?    @default("🩺")
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())

  // Stripe subscription
  stripeCustomerId   String?
  subscriptionId     String?
  plan               String    @default("none")
  subscriptionStatus String?
  currentPeriodEnd   DateTime?

  // Balance (saldo a favor por reembolsos de ODT rechazadas, en CLP)
  balance            Int       @default(0)
  balanceTransactions BrandBalanceTransaction[]
}

model BrandBalanceTransaction {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  amount        Int      // positivo = crédito; negativo = débito (uso del saldo)
  reason        String   // "refund_odt" | "use_for_odt" | "manual_adjustment"
  applicationId String?
  createdAt     DateTime @default(now())
}

model CreatorProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle       String        @unique
  bio          String        @default("")
  location     String        @default("")
  region       String?
  comuna       String?
  age          Int?
  niche        String[]
  platforms    String[]
  followers    Int           @default(0)
  igFollowers  Int?
  ttFollowers  Int?
  engagement   Float         @default(0)
  reach        Int           @default(0)
  rating       Float         @default(0)
  reviewScore  Float?
  priceFrom    Int           @default(0)
  verified     Boolean       @default(false)
  completedCampaigns Int     @default(0)
  audienceMale   Int         @default(0)
  audienceFemale Int         @default(0)
  audienceOther  Int         @default(0)
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Campaign {
  id           String         @id @default(cuid())
  brandId      String
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  status       CampaignStatus @default(DRAFT)
  niche        String
  tag          String         @default("Orgánico")
  collabTypes  String[]
  platforms    String[]
  budget       Int            @default(0)
  payPerCreator Int           @default(0)
  spots        Int            @default(0)
  filled       Int            @default(0)
  deadline     DateTime
  cover        String         @default("heat-gradient-soft")
  brief        String         @default("")
  deliverables String[]
  requirements String[]
  minFollowers Int            @default(0)
  applications Application[]
  createdAt    DateTime       @default(now())
}

model Application {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId    String
  creator      CreatorProfile    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(PENDING)
  message      String            @default("")
  proposedRate Int               @default(0)
  appliedAt    DateTime          @default(now())

  // ODT lifecycle (cuando status = ACCEPTED, esto se vuelve una ODT con su propio ciclo de pago)
  // null | pending_payment | paid | content_submitted | released | rejected
  odtStatus    String?
  // Montos (CLP enteros) — capturados al crear la ODT para no depender de cambios futuros en proposedRate
  brandAmount      Int? // lo que paga la marca = round(creatorAmount / (1 - commission))
  creatorAmount    Int? // lo que recibe el creador (== proposedRate al momento de aceptar)
  commissionAmount Int? // diferencia (oculta al creador y a la marca)
  // Referencias Stripe
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeTransferId        String?
  // Timestamps + contenido
  paidAt              DateTime?
  contentSubmittedAt  DateTime?
  contentUrl          String?
  releasedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?

  messages Message[]

  @@unique([campaignId, creatorId])
}

model Message {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body            String
  createdAt       DateTime    @default(now())
  readByBrandAt   DateTime?
  readByCreatorAt DateTime?

  @@index([applicationId, createdAt])
}
